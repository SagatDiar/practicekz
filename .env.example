# Скопируйте в .env:  cp .env.example .env
DATABASE_URL=postgresql://practice:practice@localhost:5432/practicekz
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-xxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxx
WEB_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
# Отдельная база для `npm test` (имя обязано содержать «test»: тесты очищают её перед каждым тестом)
TEST_DATABASE_URL=postgresql://practice:practice@localhost:5432/practicekz_test
# Лимит попыток входа/регистрации с одного IP за 15 минут
AUTH_RATE_LIMIT=50

# Почта для кодов подтверждения email. Пока SMTP_HOST пуст — письма печатаются в консоль API,
# а в режиме разработки код ещё и показывается на странице подтверждения.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PracticeKZ <no-reply@practicekz.kz>
